[Unit]
Description=OfferVault operations workspace
After=network.target

[Service]
Type=simple
User=offervault
Group=offervault
WorkingDirectory=/opt/offervault-operacao
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/offervault-operacao.env
ExecStart=/usr/bin/python3 /opt/offervault-operacao/server.py --database /var/lib/offervault-operacao/data.sqlite3 --web /var/www/storeinfocus.com/operacao --origin https://storeinfocus.com --port 8766
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/offervault-operacao
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
