client_max_body_size 12k;
proxy_ssl_server_name on;
proxy_ssl_name ciclo40-equipe.estudoscaso3.chatgpt.site;
proxy_ssl_verify on;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
proxy_set_header Host ciclo40-equipe.estudoscaso3.chatgpt.site;
proxy_set_header OAI-Sites-Authorization __TOKEN__;
proxy_set_header oai-authenticated-user-id "";
proxy_set_header oai-authenticated-user-email "";
proxy_set_header oai-authenticated-user-full-name "";
proxy_set_header oai-authenticated-user-full-name-encoding "";
# Only our same-origin browser writes receive an accepted upstream Origin.
set $ciclo40_origin "";
if ($http_origin = "https://storeinfocus.com") {
    set $ciclo40_origin "https://ciclo40-equipe.estudoscaso3.chatgpt.site";
}
proxy_set_header Origin $ciclo40_origin;
proxy_set_header Referer "";
proxy_cache off;
proxy_hide_header Access-Control-Allow-Origin;
proxy_hide_header Access-Control-Allow-Credentials;
proxy_read_timeout 30s;
add_header Cache-Control "no-store" always;
add_header X-Content-Type-Options nosniff always;
